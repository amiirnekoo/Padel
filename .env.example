# ==========================================
# تنظیمات محیطی پلتفرم ورزشی رالی (Rally Platform)
# ==========================================

# اطلاعات عمومی
PROJECT_NAME="Rally Padel & Tennis Court Booking Engine"
API_V1_STR=/api/v1
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# پایگاه داده (برای داکر از postgresql+asyncpg استفاده می‌شود)
# برای محیط لوکال توسعه: sqlite+aiosqlite:///./padel.db
DATABASE_URL=postgresql+asyncpg://padel_user:padel_secret_password_2026@localhost:5432/padel_production
POSTGRES_USER=padel_user
POSTGRES_PASSWORD=padel_secret_password_2026
POSTGRES_DB=padel_production

# ردیس و قفل‌های توزیع‌شده
REDIS_URL=redis://localhost:6379/0

# درگاه‌های پرداخت اینترنتی (MOCK / ZARINPAL / SHAPARAK)
PAYMENT_GATEWAY_PROVIDER=MOCK
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true

# پنل پیامک خدماتی OTP (SIMULATOR / KAVENEGAR / FARAZSMS)
SMS_PROVIDER=SIMULATOR
KAVENEGAR_API_KEY=your-kavenegar-api-key-here
KAVENEGAR_OTP_TEMPLATE=rally-otp-verify
FARAZ_API_KEY=your-faraz-api-key-here

# قواعد تجاری و رزرو
HOLD_EXPIRATION_MINUTES=10
CANCELLATION_DEADLINE_HOURS=24
CANCELLATION_PENALTY_PERCENT=10
CANCELLATION_REFUND_PERCENT=90
DEFAULT_COMMISSION_RATE=3.00
